.page { padding-bottom: 20rpx; }

/* ===== Hero ===== */
.hero { padding: 64rpx 48rpx 8rpx; text-align: center; }
.hero-badge {
  display: inline-block;
  padding: 10rpx 28rpx;
  background: #e8f0ff;
  color: #0052ff;
  border-radius: 40rpx;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}
.hero-title { font-size: 56rpx; font-weight: 700; line-height: 1.35; }
.hero-title .hl { color: #0052ff; }
.hero-desc { font-size: 28rpx; color: #4e5969; margin: 28rpx 8rpx 44rpx; }
.hero-btns { padding: 0 24rpx; }
.hero-btn {
  padding: 26rpx 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}
.hero-btn + .hero-btn { margin-top: 20rpx; }
.hero-btn-primary {
  background: linear-gradient(135deg, #0052ff, #2b7dff);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 255, 0.2);
}
.hero-btn-ghost {
  background: #fff;
  color: #0052ff;
  border: 2rpx solid #d0e0ff;
}

/* ===== 通用区块 ===== */
.section { padding: 48rpx 32rpx 0; }

/* ===== 核心功能 ===== */
.features { display: flex; flex-wrap: wrap; justify-content: space-between; }
.feature-card {
  width: 48.5%;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 20rpx;
}
.feature-icon {
  width: 84rpx;
  height: 84rpx;
  background: linear-gradient(135deg, #0052ff, #2b7dff);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.feature-title { font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; }
.feature-desc { font-size: 25rpx; color: #6b7280; line-height: 1.7; }

/* ===== 核心优势 ===== */
.adv-card {
  background: #fff;
  border: 2rpx solid #e0e9ff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.adv-title { font-size: 30rpx; font-weight: 600; color: #0052ff; margin-bottom: 12rpx; }
.adv-desc { font-size: 26rpx; color: #4e5969; line-height: 1.7; }

/* ===== 适用行业 ===== */
.industry-tags { display: flex; flex-wrap: wrap; justify-content: center; }
.industry-tag {
  padding: 16rpx 36rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: #374151;
  margin: 0 14rpx 16rpx 0;
}

/* ===== 演示横幅 ===== */
.demo-banner {
  background: linear-gradient(135deg, #0052ff 0%, #2b7dff 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(0, 82, 255, 0.2);
}
.banner-title { font-size: 40rpx; font-weight: 600; }
.banner-desc { font-size: 26rpx; opacity: 0.85; margin-top: 10rpx; }
.banner-btn {
  margin-top: 36rpx;
  display: inline-block;
  padding: 20rpx 48rpx;
  background: #fff;
  color: #0052ff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}
