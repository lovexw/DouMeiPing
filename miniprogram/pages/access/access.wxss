.access-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f0ff 0%, #f5f7fa 65%);
}
.access-card {
  width: 100%;
  background: #fff;
  border-radius: 40rpx;
  padding: 80rpx 56rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 82, 255, 0.08);
}
.brand { text-align: center; margin-bottom: 56rpx; }
.brand-name {
  font-size: 52rpx;
  font-weight: 600;
  color: #0052ff;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.brand-desc { font-size: 26rpx; color: #86909c; }
.access-input {
  height: 96rpx;
  padding: 0 32rpx;
  border: 2rpx solid #e5e6eb;
  border-radius: 24rpx;
  font-size: 32rpx;
  margin-bottom: 24rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}
.access-input.focused {
  border-color: #0052ff;
  background: #fff;
}
.input-placeholder { color: #c9cdd4; }
.access-tip {
  text-align: center;
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.8;
  margin-top: 36rpx;
}
.access-tip .highlight { color: #0052ff; font-weight: 500; }
.access-tip .sub { margin-top: 6rpx; }
