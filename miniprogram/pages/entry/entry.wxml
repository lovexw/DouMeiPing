<view class="page">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-badge">专为本地实体商家打造</view>
    <view class="hero-title">一键生成真实好评</view>
    <view class="hero-title">获得<text class="hl">平台算法</text>更多推荐</view>
    <view class="hero-desc">基于分行业写实词库与智能组合算法，生成符合美团、抖音平台偏好的优质评价，一键复制直达评价页面，提升门店评价质量与自然推荐流量。</view>
    <view class="hero-btns">
      <view class="hero-btn hero-btn-primary" hover-class="btn-hover" bindtap="enterTool">{{hasSession ? '继续使用门店工具' : '进入门店工具'}}</view>
      <view class="hero-btn hero-btn-ghost" hover-class="btn-hover" bindtap="goCoop">查看合作方案</view>
    </view>
  </view>

  <!-- 核心功能 -->
  <view class="section">
    <view class="section-head">
      <text class="t">核心功能</text>
      <text class="d">专注解决商家好评运营痛点，开箱即用</text>
    </view>
    <view class="features">
      <view class="feature-card" wx:for="{{features}}" wx:key="title">
        <view class="feature-icon">{{item.icon}}</view>
        <view class="feature-title">{{item.title}}</view>
        <view class="feature-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 核心优势 -->
  <view class="section">
    <view class="section-head">
      <text class="t">为什么抖美评更有分量</text>
      <text class="d">不止是生成文案，更是帮你拿到算法的流量加权</text>
    </view>
    <view class="adv-card" wx:for="{{advantages}}" wx:key="title">
      <view class="adv-title">{{item.title}}</view>
      <view class="adv-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 适用行业 -->
  <view class="section">
    <view class="section-head">
      <text class="t">适用行业</text>
      <text class="d">持续扩展更多本地生活业态，按需定制专属词库</text>
    </view>
    <view class="industry-tags">
      <view class="industry-tag" wx:for="{{industries}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 定价 -->
  <view class="section">
    <view class="section-head">
      <text class="t">透明定价</text>
      <text class="d">单门店一口价，无隐藏费用，开通即可使用全部功能</text>
    </view>
    <view class="plan-card {{item.recommend ? 'recommend' : ''}}" wx:for="{{plans}}" wx:key="name">
      <view class="plan-tag" wx:if="{{item.recommend}}">推荐</view>
      <view class="plan-name">{{item.name}}</view>
      <view class="plan-desc">{{item.desc}}</view>
      <view class="plan-price">¥{{item.price}}<text class="plan-unit"> / {{item.unit}}</text></view>
      <view class="plan-list">
        <view class="plan-item" wx:for="{{item.items}}" wx:for-item="li" wx:key="*this">{{li}}</view>
      </view>
      <view class="plan-btn {{item.recommend ? 'solid' : 'ghost'}}" hover-class="btn-hover" bindtap="enterTool">
        {{item.recommend ? '立即体验演示' : '先体验演示'}}
      </view>
    </view>
    <view class="value-note"><text class="strong">所有付费用户</text> 优先享受后续新增增值服务，持续迭代不加价</view>
  </view>

  <!-- 演示横幅 -->
  <view class="section">
    <view class="demo-banner">
      <view class="banner-title">马上体验抖美评系统</view>
      <view class="banner-desc">输入演示访问码，完整体验生成、复制、跳转全流程</view>
      <view class="banner-btn" hover-class="btn-hover" bindtap="enterTool">进入演示</view>
    </view>
  </view>

  <view class="page-footer">© 2026 默默传媒 · 抖美评系统 版权所有</view>
</view>
