<view class="page">
  <view class="section-head coop-head">
    <text class="t">合作咨询</text>
    <text class="d">单门店一口价，无隐藏费用，开通即可使用全部功能</text>
  </view>

  <!-- 定价方案 -->
  <view class="plans">
    <view class="plan-card {{item.recommend ? 'recommend' : ''}}" wx:for="{{plans}}" wx:key="name">
      <view class="plan-tag" wx:if="{{item.recommend}}">推荐</view>
      <view class="plan-name">{{item.name}}</view>
      <view class="plan-desc">{{item.desc}}</view>
      <view class="plan-price">¥{{item.price}}<text class="plan-unit"> / {{item.unit}}</text></view>
      <view class="plan-list">
        <view class="plan-item" wx:for="{{item.items}}" wx:for-item="li" wx:key="*this">{{li}}</view>
      </view>
      <view class="plan-btn solid" hover-class="btn-hover" bindtap="onConsult">立即咨询开通</view>
    </view>
  </view>
  <view class="value-note"><text class="strong">所有付费用户</text> 优先享受后续新增增值服务，持续迭代不加价</view>

  <!-- 合作流程 -->
  <view class="card block process-card">
    <view class="label-bar">合作流程</view>
    <view class="step" wx:for="{{process}}" wx:key="title">
      <view class="step-no">{{index + 1}}</view>
      <view class="step-body">
        <view class="step-title">{{item.title}}</view>
        <view class="step-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="card block contact-card">
    <view class="label-bar">联系方式</view>
    <view class="contact-row" wx:for="{{contacts}}" wx:key="label">
      <text class="c-label">{{item.label}}</text>
      <text class="c-value">{{item.value}}</text>
      <text class="c-copy" data-index="{{index}}" hover-class="copy-hover" bindtap="onCopyContact">复制</text>
    </view>
    <view class="contact-note">添加时请备注「默默评价助手合作」，商务会第一时间通过</view>
  </view>

  <view class="page-footer">© 2026 默默传媒 · 默默评价助手</view>
</view>
