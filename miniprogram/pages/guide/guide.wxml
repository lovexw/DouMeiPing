<view class="page">
  <view class="section-head guide-head">
    <text class="t">使用指南</text>
    <text class="d">三步完成一次好评运营，简单高效</text>
  </view>

  <view class="card block">
    <view class="label-bar">使用流程</view>
    <view class="step" wx:for="{{steps}}" wx:key="title">
      <view class="step-no">{{index + 1}}</view>
      <view class="step-body">
        <view class="step-title">{{item.title}}</view>
        <view class="step-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="card block">
    <view class="label-bar">评价小贴士</view>
    <view class="tip-item" wx:for="{{tips}}" wx:key="*this">
      <text class="tip-dot"></text>
      <text class="tip-text">{{item}}</text>
    </view>
  </view>

  <view class="card block">
    <view class="label-bar muted">常见问题</view>
    <view class="faq" wx:for="{{faqs}}" wx:key="q">
      <view class="faq-q" data-index="{{index}}" hover-class="copy-hover" bindtap="onToggleFaq">
        <text class="faq-question">{{item.q}}</text>
        <text class="faq-arrow {{item.open ? 'open' : ''}}">›</text>
      </view>
      <view class="faq-a" wx:if="{{item.open}}">{{item.a}}</view>
    </view>
  </view>

  <view class="page-footer">© 2026 默默传媒 · 默默评价助手</view>
</view>
