.page { padding: 0 32rpx; }
.guide-head { padding: 40rpx 0 8rpx; }
.block { margin-bottom: 24rpx; }

/* ===== 小贴士 ===== */
.tip-item { display: flex; padding: 10rpx 0; }
.tip-dot {
  width: 10rpx;
  height: 10rpx;
  background: #0052ff;
  border-radius: 50%;
  margin: 20rpx 18rpx 0 0;
  flex-shrink: 0;
}
.tip-text { font-size: 27rpx; color: #4e5969; flex: 1; }

/* ===== 常见问题 ===== */
.faq + .faq { border-top: 2rpx solid #f2f3f5; }
.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}
.faq-question { font-size: 28rpx; font-weight: 500; color: #1d2129; flex: 1; }
.faq-arrow {
  color: #86909c;
  font-size: 32rpx;
  transition: transform 0.2s;
  flex-shrink: 0;
}
.faq-arrow.open { transform: rotate(90deg); }
.faq-a {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
  padding: 0 0 26rpx;
}
.copy-hover { opacity: 0.7; }
