/* 抖美评 · 全局样式（设计规范对齐官网与 H5 演示版） */
page {
  background: #f5f7fa;
  color: #1d2129;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

/* ===== 带竖条的小标题 ===== */
.label-bar {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 500;
  color: #0052ff;
  margin-bottom: 24rpx;
}
.label-bar::before {
  content: "";
  width: 8rpx;
  height: 24rpx;
  background: #0052ff;
  border-radius: 4rpx;
  margin-right: 12rpx;
}
.label-bar.muted { color: #86909c; }
.label-bar.muted::before { background: #4cd964; }

/* ===== 按钮 ===== */
.btn {
  padding: 26rpx 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}
.btn-primary {
  background: linear-gradient(135deg, #0052ff, #2b7dff);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 255, 0.2);
}
.btn-secondary {
  background: #e8f0ff;
  color: #0052ff;
}
.btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

/* ===== 区块标题 ===== */
.section-head {
  text-align: center;
  margin-bottom: 40rpx;
}
.section-head .t {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}
.section-head .d {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* ===== 定价卡片（首页 / 合作页共用） ===== */
.plan-card {
  position: relative;
  background: #fff;
  border: 4rpx solid transparent;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}
.plan-card.recommend {
  border-color: #0052ff;
  box-shadow: 0 12rpx 40rpx rgba(0, 82, 255, 0.12);
}
.plan-tag {
  position: absolute;
  top: -20rpx;
  right: 40rpx;
  padding: 6rpx 24rpx;
  background: linear-gradient(135deg, #0052ff, #2b7dff);
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
}
.plan-name { font-size: 34rpx; font-weight: 600; }
.plan-desc { font-size: 26rpx; color: #6b7280; margin-top: 8rpx; }
.plan-price { font-size: 72rpx; font-weight: 700; margin-top: 20rpx; }
.plan-unit { font-size: 24rpx; font-weight: 400; color: #6b7280; }
.plan-list { margin: 24rpx 0 32rpx; }
.plan-item {
  font-size: 27rpx;
  color: #374151;
  padding: 10rpx 0;
  display: flex;
  align-items: center;
}
.plan-item::before {
  content: "✓";
  color: #0052ff;
  font-weight: 600;
  margin-right: 16rpx;
}
.plan-btn {
  padding: 22rpx 0;
  border-radius: 20rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 500;
}
.plan-btn.solid {
  background: linear-gradient(135deg, #0052ff, #2b7dff);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 255, 0.2);
}
.plan-btn.ghost {
  border: 2rpx solid #d0e0ff;
  color: #0052ff;
}
.value-note {
  text-align: center;
  font-size: 25rpx;
  color: #6b7280;
  margin-top: 8rpx;
}
.value-note .strong { color: #0052ff; font-weight: 500; }

/* ===== 步骤列表（指南 / 合作页共用） ===== */
.step { display: flex; align-items: flex-start; }
.step + .step { margin-top: 32rpx; }
.step-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0052ff, #2b7dff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.step-title { font-size: 30rpx; font-weight: 600; }
.step-desc { font-size: 26rpx; color: #6b7280; margin-top: 6rpx; }

/* ===== 页面底部版权 ===== */
.page-footer {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 48rpx 0 60rpx;
}
