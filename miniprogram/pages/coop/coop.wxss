.page { padding: 0 32rpx; }
.coop-head { padding: 40rpx 0 8rpx; }
.plans { margin-top: 8rpx; }
.block { margin-bottom: 24rpx; }
.process-card { margin-top: 40rpx; }

/* ===== 联系方式 ===== */
.contact-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  font-size: 28rpx;
}
.contact-row + .contact-row { border-top: 2rpx solid #f2f3f5; }
.c-label { color: #86909c; width: 160rpx; flex-shrink: 0; }
.c-value { color: #1d2129; font-weight: 500; flex: 1; margin-right: 16rpx; word-break: break-all; }
.c-copy {
  color: #0052ff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: #e8f0ff;
  flex-shrink: 0;
}
.contact-note {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 20rpx;
}
.copy-hover { opacity: 0.7; }
